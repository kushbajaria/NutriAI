rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isString(field) {
      return request.resource.data[field] is string;
    }

    function isNumber(field) {
      return request.resource.data[field] is number || request.resource.data[field] is int;
    }

    function hasFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function docSizeOk() {
      // Limit individual documents to ~500KB to prevent abuse
      return request.resource.size() < 512 * 1024;
    }

    // ── User profiles ───────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Allow create on signup
      allow create: if isOwner(userId)
                    && docSizeOk();

      // Allow update — validate profilePhoto size if present
      allow update: if isOwner(userId)
                    && docSizeOk()
                    && (
                      !('profilePhoto' in request.resource.data)
                      || request.resource.data.profilePhoto == null
                      || (request.resource.data.profilePhoto is string
                          && request.resource.data.profilePhoto.size() < 500000)
                    );

      // Allow delete (account deletion)
      allow delete: if isOwner(userId);

      // ── Pantry ──────────────────────────────────────────────────
      match /pantry/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
                     && docSizeOk();
      }

      // ── Meals ───────────────────────────────────────────────────
      match /meals/{docId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
                      && hasFields(['name', 'cal', 'date'])
                      && isString('name')
                      && isNumber('cal')
                      && request.resource.data.cal >= 0
                      && request.resource.data.cal <= 10000
                      && isString('date')
                      && request.resource.data.name.size() <= 200
                      && docSizeOk();

        // No client-side update or delete of meals
        allow update, delete: if isOwner(userId);
      }

      // ── Streaks ─────────────────────────────────────────────────
      match /streaks/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
                     && hasFields(['count', 'activityDates', 'earnedToday'])
                     && isNumber('count')
                     && request.resource.data.count >= 0
                     && request.resource.data.count <= 3650
                     && request.resource.data.activityDates is list
                     && request.resource.data.activityDates.size() <= 60
                     && request.resource.data.earnedToday is bool
                     && docSizeOk();
      }

      // ── Workouts ────────────────────────────────────────────────
      match /workouts/{docId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
                      && hasFields(['type', 'date'])
                      && isString('type')
                      && isString('date')
                      && request.resource.data.type.size() <= 100
                      && (!('calBurn' in request.resource.data) || (isNumber('calBurn') && request.resource.data.calBurn >= 0 && request.resource.data.calBurn <= 10000))
                      && docSizeOk();

        allow update, delete: if isOwner(userId);
      }

      // ── Water tracking ──────────────────────────────────────────
      match /water/{docId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
                     && (!('totalOz' in request.resource.data) || (isNumber('totalOz') && request.resource.data.totalOz >= 0 && request.resource.data.totalOz <= 1000))
                     && (!('entries' in request.resource.data) || (request.resource.data.entries is list && request.resource.data.entries.size() <= 100))
                     && docSizeOk();
      }

      // ── Weight log ──────────────────────────────────────────────
      match /weightLog/{docId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
                      && hasFields(['value', 'unit', 'timestamp'])
                      && isNumber('value')
                      && request.resource.data.value > 0
                      && request.resource.data.value <= 1500
                      && isString('unit')
                      && (request.resource.data.unit == 'lbs' || request.resource.data.unit == 'kg')
                      && isNumber('timestamp')
                      && docSizeOk();

        allow update, delete: if isOwner(userId);
      }
    }

    // ── Recipes ─────────────────────────────────────────────────────
    match /recipes/{recipeId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Reviews: authenticated users can read all, create own
      match /reviews/{reviewId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && hasFields(['stars', 'text', 'uid', 'createdAt'])
                      && request.resource.data.stars is int
                      && request.resource.data.stars >= 1
                      && request.resource.data.stars <= 5
                      && isString('text')
                      && request.resource.data.text.size() <= 1000
                      && docSizeOk();
        allow update, delete: if false;
      }
    }
  }
}
